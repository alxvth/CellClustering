{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "CellClusteringSettings",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CELLCLUSTERING_BUILD_TESTS": "ON",
        "CELLCLUSTERING_BUILD_EXAMPLES": "ON",
        "CELLCLUSTERING_INSTALL": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "default",
      "displayName": "Default",
      "description": "Platform-independent default: uses whatever compiler is found",
      "inherits": "CellClusteringSettings"
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "description": "Build on linux using Ninja generator",
      "inherits": "CellClusteringSettings",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "description": "Using compilers for Visual Studio (x86_x64 architecture)",
      "inherits": "CellClusteringSettings",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Default (Release)",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "msvc-release",
      "displayName": "Release",
      "configuration": "Release",
      "configurePreset": "windows-msvc",
      "verbose": false
    },
    {
      "name": "msvc-release-rebuild",
      "displayName": "Release (rebuild)",
      "inherits": "msvc-release",
      "cleanFirst": true
    },
    {
      "name": "msvc-debug",
      "displayName": "Debug",
      "configuration": "Debug",
      "configurePreset": "windows-msvc",
      "verbose": true
    },
    {
      "name": "msvc-debug-rebuild",
      "displayName": "Debug (rebuild)",
      "inherits": "msvc-debug",
      "cleanFirst": true
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "configuration": "RelWithDebInfo",
      "configurePreset": "windows-msvc",
      "verbose": true
    },
    {
      "name": "msvc-relwithdebinfo-rebuild",
      "displayName": "RelWithDebInfo (rebuild)",
      "inherits": "msvc-relwithdebinfo",
      "cleanFirst": true
    },
    {
      "name": "linux-release",
      "displayName": "Release",
      "configuration": "Release",
      "configurePreset": "linux-gcc",
      "verbose": false
    },
    {
      "name": "linux-release-rebuild",
      "displayName": "Release (rebuild)",
      "inherits": "linux-release",
      "cleanFirst": true
    },
    {
      "name": "linux-debug",
      "displayName": "Debug",
      "configuration": "Debug",
      "configurePreset": "linux-gcc",
      "verbose": true
    },
    {
      "name": "linux-debug-rebuild",
      "displayName": "Debug (rebuild)",
      "inherits": "linux-debug",
      "cleanFirst": true
    }
  ],
  "testPresets": [
    {
      "name": "CellClusteringTestSettings",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "default",
      "displayName": "Default (Release)",
      "inherits": "CellClusteringTestSettings",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "msvc-release",
      "displayName": "Release",
      "inherits": "CellClusteringTestSettings",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "displayName": "Debug",
      "inherits": "CellClusteringTestSettings",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "linux-release",
      "displayName": "Release",
      "inherits": "CellClusteringTestSettings",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "displayName": "Debug",
      "inherits": "CellClusteringTestSettings",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    }
  ]
}